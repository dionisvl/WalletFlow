# Copy to .env and fill in. .env is gitignored.
# Looked up in the working directory, then in ~/Library/Application Support/WalletFlow/.env.
# Real environment variables win over .env.

# Etherscan API V2, one key for all EVM chains: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# TronGrid, optional (faster sync): https://www.trongrid.io/dashboard
TRONGRID_API_KEY=

# Chains to hide and never sync. Base, Optimism and BNB Chain need a paid Etherscan plan.
# Keys: ethereum, arbitrum, base, optimism, polygon, bsc, linea, tron
IGNORE_CHAINS=base,optimism,bsc

# Per-address transfer limit (default 10000, 0 = no limit). Before the first sync an address
# is skipped if its recent activity would exceed this within a year; any sync stops at the limit.
# Personal wallets stay far below; a bigger history usually means an exchange or a service.
# MAX_TRANSFERS_PER_ADDRESS=10000

# Optional.
# WALLETFLOW_ADDR=127.0.0.1:8080
# WALLETFLOW_DB=/path/to/walletflow.db
